# Copy to .env and fill in. Loaded automatically by config.py (python-dotenv).
# Never commit your actual .env -- it's in .gitignore.

# --- Required ---

AWS_REGION=us-east-1

# IAM role SageMaker will assume to pull the container image and download
# model weights. Must have a trust policy allowing sagemaker.amazonaws.com
# to assume it, plus permissions to read from wherever it fetches weights
# from (S3 if you're staging weights there) and pull from ECR. See README
# "IAM role setup" for the exact trust policy + a minimal permissions
# policy, and for AmazonSageMakerFullAccess as the quick-start alternative.
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/your-sagemaker-execution-role

# --- Only needed for gated models (e.g. llama-3.1-8b-instruct in models.yaml) ---

# Hugging Face token with read access, after accepting the model's license
# on huggingface.co. Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Set after running infra/setup_lambda_api.py ---

# Full route URL, used by scripts/test_endpoint_via_api.py.
# e.g. https://abc123xyz.execute-api.us-east-1.amazonaws.com/v1/chat/completions
# API_GATEWAY_URL=
